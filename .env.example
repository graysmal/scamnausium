PORT=4000
OPERATOR_DEMO_SECRET=
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DATABASE=scamnasium
SPACETIMEDB_SERVICE_TOKEN=
# Provider scaffolding only: these values do not activate an integration.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=
PHOTON_TEST_SENDER=
ENABLE_LIVE_MESSAGING=false
# Read-only polling of iMessages from PHOTON_TEST_SENDER -> PHOTON_AGENT_HANDLE (min 5000 ms).
ENABLE_PHOTON_POLLING=false
PHOTON_POLL_INTERVAL_MS=5000
ALLOWED_TEST_CONTACTS=
ELEVENLABS_API_KEY=
# Read-only call feed from ElevenLabs (no tunnel needed). Min interval 8000 ms.
ENABLE_ELEVENLABS_POLLING=false
ELEVENLABS_POLL_INTERVAL_MS=10000
ELEVENLABS_LOOKBACK_SECS=3600
# Public honeypot number shown in the UI (display only)
HONEYPOT_NUMBER=
ELEVENLABS_AGENT_ID=
# HMAC secret ElevenLabs shows when you create the post-call webhook. Webhook URL: https://<tunnel>/webhooks/elevenlabs
ELEVENLABS_WEBHOOK_SECRET=
